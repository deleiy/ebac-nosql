// 1
db.books.countDocuments({
  status: { $ne: "PUBLISH" },
  pageCount: { $lt: 300 }
})

// 2
db.books.countDocuments({
  title: {
    $regex: /MongoDB.*SQL Server|SQL Server.*MongoDB/i
  }
})

// 3
db.books.countDocuments({
  isbn: /^18/
})

// 4
db.books.countDocuments({
  longDescription: {
    $regex: /JAVA|Mobile/i
  }
})
