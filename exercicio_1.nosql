// 1. Quantos livros não estão publicados e possuem pageCount menor que 300
db.books.find(
{
status: { $ne: "PUBLISH" },
pageCount: { $lt: 300 }
},
{
title: 1,
status: 1,
pageCount: 1,
_id: 0
}
)

// 2. Livros que possuem MongoDB e SQL Server no título
db.books.find(
{
title: {
$regex: /MongoDB.*SQL Server|SQL Server.*MongoDB/i
}
},
{
title: 1,
_id: 0
}
)

// 3. ISBN começa com 18
db.books.find(
{
isbn: /^18/
},
{
isbn: 1,
title: 1,
_id: 0
}
)

// 4. LongDescription contém JAVA ou Mobile
db.books.find(
{
longDescription: {
$regex: /JAVA|Mobile/i
}
},
{
title: 1,
longDescription: 1,
_id: 0
}
)
